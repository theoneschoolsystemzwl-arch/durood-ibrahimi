rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function self(uid) { return signed() && request.auth.uid == uid; }
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function usernamePath(username) {
      return /databases/$(database)/documents/usernames/$(username);
    }
    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }
    function sequencePath() {
      return /databases/$(database)/documents/system/membership;
    }
    function countPath(uid) {
      return /databases/$(database)/documents/memberCounts/$(uid);
    }
    function globalPath() {
      return /databases/$(database)/documents/publicStats/global;
    }
    function activeLoginPath(uid) {
      return /databases/$(database)/documents/activeLogins/$(uid);
    }
    function validGender(gender) {
      return gender == 'male' || gender == 'female';
    }
    // Existing pre-gender members are treated as male, without rewriting data.
    function genderOf(profile) {
      return profile.get('gender', 'male');
    }
    function myGender() {
      return genderOf(get(memberPath(request.auth.uid)).data);
    }
    function matchingGender(profile) {
      return genderOf(profile) == myGender();
    }
    function invitationMatches(invite, gender) {
      let inviter = get(memberPath(invite.byUid)).data;
      return validGender(gender) &&
        (inviter.role == 'owner' &&
          (invite.get('gender', 'any') == 'any' || invite.get('gender', 'any') == gender) ||
        inviter.role != 'owner' &&
          genderOf(inviter) == gender &&
          invite.get('gender', genderOf(inviter)) == gender);
    }
    function active(uid) {
      return signed() && exists(memberPath(uid)) &&
        get(memberPath(uid)).data.disabled == false;
    }
    // Only the existing Firebase Authentication account designated by the
    // project administrator is the new Master Owner. DI-1 is not a login ID.
    function trustedOwnerUid() {
      return 'vt06NK7DcmgPpUKD4R7EgwzAxIH3';
    }
    function deletedTestOwnerUid() {
      return 'ecrykLlmTAbV90llOdQVRSX4OyE3';
    }
    function legacyOwnerUid() {
      return deletedTestOwnerUid();
    }
    function legacyIsOwner() {
      return signed() && request.auth.uid == trustedOwnerUid();
    }
    function owner() {
      return signed() && (request.auth.token.get('owner', false) == true || legacyIsOwner()) && active(request.auth.uid);
    }
    // The Firebase Auth token includes the server-issued auth_time. An
    // authenticated second sign-in can atomically take over this member lease.
    // The old token then fails database reads/writes; the Owner is exempt.
    function activeLogin() {
      return signed() && (owner() ||
        (exists(activeLoginPath(request.auth.uid)) &&
          get(activeLoginPath(request.auth.uid)).data.authTime ==
            request.auth.token.auth_time));
    }
    function currentMember() {
      return signed() && active(request.auth.uid) && activeLogin();
    }
    function validUsername(name) {
      return name is string &&
        name.matches('^[a-z0-9._-]{3,24}$') &&
        !name.matches('^di-[0-9]+$');
    }
    function validInvite(code) {
      return code is string && code.matches('^[a-z0-9]{6}$');
    }
    // DI-1 is ONLY the first member serial, not a login identifier.
    // Recover a missing profile solely for an already trusted Firebase Auth
    // identity. Public email/password registration cannot grant owner rights.
    function trustedOwnerIdentity(uid) {
      return self(uid) &&
        (legacyIsOwner() || request.auth.token.get('owner', false) == true);
    }
    function initialOwnerProfile(uid) {
      let m = request.resource.data;
      return trustedOwnerIdentity(uid) &&
        m.keys().hasOnly(['uid','username','name','role','memberNumber',
          'serial','disabled','inviterUid','createdAt']) &&
        m.keys().hasAll(['uid','username','name','role','memberNumber',
          'serial','disabled','inviterUid','createdAt']) &&
        m.uid == uid && m.username == 'owner' &&
        m.name is string && m.name.size() >= 2 && m.name.size() <= 60 &&
        m.role == 'owner' && m.memberNumber == 1 && m.serial == 'DI-1' &&
        m.disabled == false && m.inviterUid == null &&
        m.createdAt == request.time &&
        (
          (exists(sequencePath()) &&
            get(sequencePath()).data.ownerUid == uid &&
            get(sequencePath()).data.lastNumber is int &&
            get(sequencePath()).data.lastNumber >= 1) ||
          (exists(sequencePath()) &&
            uid == trustedOwnerUid() &&
            get(sequencePath()).data.ownerUid == deletedTestOwnerUid() &&
            get(sequencePath()).data.lastNumber is int &&
            get(sequencePath()).data.lastNumber >= 1 &&
            !exists(memberPath(deletedTestOwnerUid())) &&
            getAfter(sequencePath()).data.ownerUid == uid &&
            getAfter(sequencePath()).data.lastNumber ==
              get(sequencePath()).data.lastNumber) ||
          (!exists(sequencePath()) &&
            getAfter(sequencePath()).data.ownerUid == uid &&
            getAfter(sequencePath()).data.lastNumber == 1)
        );
    }
    function initialOwnerSequence() {
      let d = request.resource.data;
      let uid = request.auth.uid;
      return signed() && trustedOwnerIdentity(uid) &&
        d.keys().hasOnly(['ownerUid','lastNumber','updatedAt']) &&
        d.keys().hasAll(['ownerUid','lastNumber','updatedAt']) &&
        d.ownerUid == uid && d.lastNumber == 1 &&
        d.updatedAt == request.time &&
        getAfter(memberPath(uid)).data.uid == uid &&
        getAfter(memberPath(uid)).data.role == 'owner' &&
        getAfter(memberPath(uid)).data.memberNumber == 1 &&
        getAfter(memberPath(uid)).data.serial == 'DI-1';
    }
    // One-time, atomic migration of the abandoned test-owner sequence.
    // A deleted old owner must have no member document; numbering is preserved.
    // The target owner profile must be created within this same transaction.
    function restoreDeletedTestOwnerSequence() {
      let d=request.resource.data;
      let uid=request.auth.uid;
      return signed() && uid == trustedOwnerUid() &&
        resource.data.ownerUid == deletedTestOwnerUid() &&
        !exists(memberPath(deletedTestOwnerUid())) &&
        !exists(memberPath(uid)) &&
        resource.data.lastNumber is int &&
        resource.data.lastNumber >= 1 &&
        d.diff(resource.data).affectedKeys().hasOnly(['ownerUid','updatedAt']) &&
        d.ownerUid == uid &&
        d.updatedAt == request.time &&
        getAfter(memberPath(uid)).data.uid == uid &&
        getAfter(memberPath(uid)).data.role == 'owner' &&
        getAfter(memberPath(uid)).data.serial == 'DI-1' &&
        getAfter(memberPath(uid)).data.memberNumber == 1;
    }
    function allowedMemberCreate(uid) {
      let m = request.resource.data;
      return self(uid) && !exists(memberPath(uid)) &&
        m.keys().hasOnly(['uid','username','name','role','memberNumber',
          'serial','inviterUid','inviteCode','gender','disabled','pledgeAcceptedAt','createdAt']) &&
        m.keys().hasAll(['uid','username','name','role','memberNumber',
          'serial','inviterUid','inviteCode','gender','disabled','pledgeAcceptedAt','createdAt']) &&
        m.uid == uid && validUsername(m.username) &&
        m.name is string && m.name.size() >= 2 && m.name.size() <= 60 &&
        m.role == 'member' && m.disabled == false && validGender(m.gender) &&
        m.memberNumber is int && m.memberNumber >= 2 &&
        m.serial == 'DI-' + string(m.memberNumber) &&
        m.pledgeAcceptedAt == request.time && m.createdAt == request.time &&
        validInvite(m.inviteCode) &&
        exists(invitationPath(m.inviteCode)) &&
        get(invitationPath(m.inviteCode)).data.used == false &&
        get(invitationPath(m.inviteCode)).data.revoked == false &&
        m.inviterUid == get(invitationPath(m.inviteCode)).data.byUid &&
        active(m.inviterUid) &&
        invitationMatches(get(invitationPath(m.inviteCode)).data, m.gender) &&
        getAfter(invitationPath(m.inviteCode)).data.used == true &&
        getAfter(invitationPath(m.inviteCode)).data.usedByUid == uid &&
        getAfter(usernamePath(m.username)).data.uid == uid &&
        exists(sequencePath()) &&
        m.memberNumber == get(sequencePath()).data.lastNumber + 1 &&
        getAfter(sequencePath()).data.lastNumber == m.memberNumber &&
        getAfter(sequencePath()).data.lastMemberUid == uid;
    }
    function signupCounter() {
      let d = request.resource.data;
      return currentMember() == false && signed() &&
        !exists(memberPath(request.auth.uid)) &&
        resource.data.lastNumber is int && resource.data.lastNumber >= 1 &&
        d.keys().hasOnly(['lastNumber','ownerUid','lastMemberUid','updatedAt']) &&
        d.keys().hasAll(['lastNumber','ownerUid','lastMemberUid','updatedAt']) &&
        d.ownerUid == resource.data.ownerUid &&
        d.lastNumber == resource.data.lastNumber + 1 &&
        d.lastMemberUid == request.auth.uid &&
        d.updatedAt == request.time &&
        getAfter(memberPath(request.auth.uid)).data.memberNumber == d.lastNumber &&
        getAfter(memberPath(request.auth.uid)).data.role == 'member';
    }
    match /members/{uid} {
      allow get: if self(uid) || owner() ||
        (currentMember() && matchingGender(resource.data));
      allow list: if owner() ||
        (currentMember() && request.query.limit != null &&
         request.query.limit <= 200 && resource.data.inviterUid == request.auth.uid);
      allow create: if allowedMemberCreate(uid) || initialOwnerProfile(uid);
      allow update: if owner() && uid != request.auth.uid &&
        resource.data.role == 'member' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled','updatedAt']) &&
        request.resource.data.disabled is bool &&
        request.resource.data.updatedAt == request.time
        || (self(uid) && currentMember() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }
    match /system/{docId} {
      allow get: if docId == 'membership' && signed();
      allow list, delete: if false;
      allow create: if docId == 'membership' && initialOwnerSequence();
      allow update: if docId == 'membership' &&
        (signupCounter() || restoreDeletedTestOwnerSequence());
    }
    match /usernames/{username} {
      allow get: if signed() && validUsername(username);
      allow list, update, delete: if false;
      allow create: if signed() && validUsername(username) &&
        request.resource.data.keys().hasOnly(['uid','createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        !exists(memberPath(request.auth.uid)) &&
        getAfter(memberPath(request.auth.uid)).data.username == username;
    }
    match /invitations/{code} {
      allow get: if signed() && validInvite(code);
      allow list, delete: if false;
      allow create: if validInvite(code) && currentMember() &&
        request.resource.data.keys().hasOnly(['byUid','gender','used','revoked','createdAt']) &&
        request.resource.data.keys().hasAll(['byUid','gender','used','revoked','createdAt']) &&
        request.resource.data.byUid == request.auth.uid &&
        request.resource.data.gender == (owner() ? 'any' : myGender()) &&
        request.resource.data.used == false &&
        request.resource.data.revoked == false &&
        request.resource.data.createdAt == request.time;
      allow update: if signed() &&
        resource.data.used == false && resource.data.revoked == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedByUid','usedAt']) &&
        request.resource.data.used == true &&
        request.resource.data.usedByUid == request.auth.uid &&
        request.resource.data.usedAt == request.time &&
        !exists(memberPath(request.auth.uid)) &&
        getAfter(memberPath(request.auth.uid)).data.inviteCode == code &&
        getAfter(memberPath(request.auth.uid)).data.inviterUid == resource.data.byUid &&
        invitationMatches(resource.data,
          getAfter(memberPath(request.auth.uid)).data.gender);
    }
    // Auth-token-bound lease; arbitrary client-provided device IDs by
    // themselves are NOT an authorization mechanism.
    function validActiveLogin(uid) {
      let s=request.resource.data;
      return self(uid) && active(uid) &&
        request.auth.token.auth_time is int &&
        s.keys().hasOnly(['authTime','deviceId','claimedAt']) &&
        s.keys().hasAll(['authTime','deviceId','claimedAt']) &&
        s.authTime == request.auth.token.auth_time &&
        s.deviceId is string &&
        s.deviceId.size() >= 16 && s.deviceId.size() <= 128 &&
        s.claimedAt == request.time;
    }
    match /activeLogins/{uid} {
      allow get: if self(uid) || owner();
      allow list: if false;
      allow create, update: if validActiveLogin(uid);
      allow delete: if self(uid) &&
        resource.data.authTime == request.auth.token.auth_time;
    }
    function validPrayerStatuses(values) {
      return values is map &&
        values.keys().hasOnly(['fajr','dhuhr','asr','maghrib','isha']) &&
        values.values().hasOnly(['jamat','solo','made','missed','clear']);
    }
    match /memberPrivate/{uid}/prayers/{date} {
      allow get, list: if self(uid) && currentMember();
      allow create, update: if self(uid) && currentMember() &&
        date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['date','statuses','updatedAt']) &&
        request.resource.data.keys().hasAll(['date','statuses','updatedAt']) &&
        request.resource.data.date == date &&
        validPrayerStatuses(request.resource.data.statuses) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /memberPrivate/{uid}/{doc=**} {
      allow read, write: if false;
    }
    function previousPersonal(uid) {
      return exists(countPath(uid)) ? get(countPath(uid)).data.total : 0;
    }
    function previousGlobal() {
      return exists(globalPath()) ? get(globalPath()).data.totalRecitations : 0;
    }
    function updatedPersonal(uid) {
      let d = request.resource.data;
      let amount = d.lastEntryAmount;
      return self(uid) && currentMember() &&
        d.keys().hasOnly(['memberUid','gender','total','lastEntryAmount','updatedAt']) &&
        d.keys().hasAll(['memberUid','gender','total','lastEntryAmount','updatedAt']) &&
        d.memberUid == uid && d.gender == myGender() && d.total is int && d.total >= 0 &&
        amount is int && amount >= 1 && amount <= 10000 &&
        d.total == previousPersonal(uid) + amount &&
        d.updatedAt == request.time &&
        getAfter(globalPath()).data.totalRecitations == previousGlobal() + amount &&
        getAfter(globalPath()).data.lastEntryUid == uid &&
        getAfter(globalPath()).data.lastEntryAmount == amount;
    }
    function updatedGlobal() {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let amount = d.lastEntryAmount;
      return currentMember() &&
        d.keys().hasOnly(['totalRecitations','lastEntryAmount','lastEntryUid','updatedAt']) &&
        d.keys().hasAll(['totalRecitations','lastEntryAmount','lastEntryUid','updatedAt']) &&
        d.totalRecitations is int && d.totalRecitations >= 0 &&
        amount is int && amount >= 1 && amount <= 10000 &&
        d.lastEntryUid == uid &&
        d.totalRecitations == previousGlobal() + amount &&
        d.updatedAt == request.time &&
        getAfter(countPath(uid)).data.total == previousPersonal(uid) + amount &&
        getAfter(countPath(uid)).data.lastEntryAmount == amount;
    }
    match /memberCounts/{uid} {
      allow get: if owner() ||
        (currentMember() &&
          (self(uid) || (exists(memberPath(uid)) &&
            matchingGender(get(memberPath(uid)).data))));
      // Gender-constrained queries only: never expose cross-side rankings.
      allow list: if owner() ||
        (currentMember() && request.query.limit != null &&
          request.query.limit <= 200 &&
          resource.data.gender == myGender());
      allow create, update: if updatedPersonal(uid);
      allow delete: if false;
    }
    match /publicStats/{docId} {
      allow get, list: if true;
      allow create, update: if docId == 'global' && updatedGlobal();
      allow delete: if false;
    }
    // Legacy Android data remains accessible under its original restrictions.
    function approvedLegacyMember(memberUid) {
      let member = /databases/$(database)/documents/memberAccess/$(memberUid);
      return memberUid != legacyOwnerUid() && exists(member) && get(member).data.enabled == true;
    }
    function sameLegacyMemberAccount(memberUid) {
      return signed() && request.auth.uid == memberUid &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        approvedLegacyMember(memberUid);
    }
    function activeLegacyDevice(memberUid) {
      let lease = /databases/$(database)/documents/memberSessions/$(memberUid);
      return signed() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous' &&
        approvedLegacyMember(memberUid) && exists(lease) &&
        get(lease).data.deviceUid == request.auth.uid;
    }
    function validLegacyProfile() {
      let profile = request.resource.data;
      return profile.keys().hasAll(['displayName','phone']) &&
        profile.keys().hasOnly(['displayName','phone']) &&
        profile.displayName is string &&
        profile.displayName.size() >= 1 && profile.displayName.size() <= 80 &&
        profile.phone is string && profile.phone.size() <= 32;
    }
    match /ownerProfiles/DI-1 {
      allow get: if legacyIsOwner();
      allow create, update: if legacyIsOwner() && validLegacyProfile();
      allow list, delete: if false;
    }
    match /memberSessions/{memberUid} {
      allow get: if sameLegacyMemberAccount(memberUid);
      allow create, update: if sameLegacyMemberAccount(memberUid) &&
        request.resource.data.keys().hasOnly(['deviceUid']) &&
        request.resource.data.deviceUid is string &&
        request.resource.data.deviceUid.size() >= 1 &&
        request.resource.data.deviceUid.size() <= 128;
      allow delete: if activeLegacyDevice(memberUid);
    }
    match /members/{memberUid}/private/profile {
      allow get: if activeLegacyDevice(memberUid);
      allow create, update: if activeLegacyDevice(memberUid) && validLegacyProfile();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
